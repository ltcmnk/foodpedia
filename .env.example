# ─────────────────────────────────────────
# FOODPEDIA — Configuração de Ambiente
# ─────────────────────────────────────────
# Copie para .env e ajuste os valores:
#   cp .env.example .env

# Ambiente Flask
FLASK_ENV=development
FLASK_SECRET_KEY=troque-isso-por-algo-aleatorio

# ── Provedor de IA ────────────────────────
# Opções: ollama | gemini | demo
AI_PROVIDER=ollama

# Modo demo — sem IA, receitas pré-geradas (sobrescreve AI_PROVIDER)
DEMO_MODE=false

# ── Ollama (IA local) ─────────────────────
# Requer Ollama instalado: https://ollama.com
# Instale o modelo: ollama pull gemma3
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=gemma3:latest

# ── Google Gemini (API key gratuita) ──────
# Obtenha gratuitamente em: https://aistudio.google.com/apikey
# Limite gratuito: 15 req/min, 1500 req/dia, sem cartão de crédito
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# ── Configurações Gerais ──────────────────
REQUEST_TIMEOUT=30
PORT=5001
